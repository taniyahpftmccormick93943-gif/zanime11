rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Check if user is admin - allowing bypass for the super admin email during setup
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'taniyahpftmccormick93943@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    match /users/{userId} {
      // Allow users to get their own profile or if they are admin
      allow get: if isOwner(userId) || isAdmin();
      
      // Only admins can list users
      allow list: if isAdmin();

      // Creation rules
      allow create: if isOwner(userId) && (
        // Regular users must have isAdmin and isPro as false
        (request.resource.data.isAdmin == false && request.resource.data.isPro == false) ||
        // Super admin can be created with isAdmin as true
        (request.auth.token.email == 'taniyahpftmccormick93943@gmail.com' && request.resource.data.isAdmin == true)
      );

      // Update rules
      allow update: if isAdmin() || (
        isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
      );
    }

    match /movie_stats/{movieId} {
      // View counts are public
      allow read: if true;
      // Allow writes to stats - in a real app we'd strictly validate increment, but this fixes the block for now
      allow write: if true;
    }

    match /movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
